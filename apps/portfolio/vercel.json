{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/spreadsheet",
      "destination": "https://celina-app.fly.dev/spreadsheet"
    },
    {
      "source": "/spreadsheet/:path*",
      "destination": "https://celina-app.fly.dev/spreadsheet/:path*"
    }
  ]
}
