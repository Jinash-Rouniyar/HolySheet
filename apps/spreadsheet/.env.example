# ---------------------------------------------------------------------------
# Client (public) — bundled into the browser. Only non-secret values here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SYNCFUSION_LICENSE=your_syncfusion_license_key_here

# ---------------------------------------------------------------------------
# Server-only — never exposed to the browser. Read by the agent route handlers.
# ---------------------------------------------------------------------------
# Default: OpenAI GPT-5.6 Terra. Luna is cheaper but weak at tools.
# Flagship: AGENT_MODEL=gpt-5.6-sol. Claude: AGENT_PROVIDER=anthropic.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-5.6-terra
# OpenAI Responses reasoning (tools + traces). none disables traces.
# AGENT_REASONING_EFFORT=medium
# AGENT_REASONING_SUMMARY=detailed
# Claude extended thinking (only when AGENT_PROVIDER=anthropic). 0 disables.
# AGENT_THINKING_BUDGET=6000

# Web search (single agent tool). Provider is Tavily by default, Exa as fallback.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here

# SEC EDGAR (required). Akamai rejects anonymous or slash-only User-Agents.
# Use a name, version, and contact email, e.g. "HolySheet Celina 1.0 you@domain".
SEC_USER_AGENT=HolySheet Celina 1.0 you@domain

# Sandbox for the bash/python tools. A jailed scratch dir is created per session
# under this root. Keep it inside the app dir or an ephemeral disk.
AGENT_SANDBOX_ROOT=./.agent-sandbox
# Absolute path to a python3 interpreter for the `python` tool (optional).
AGENT_PYTHON_BIN=python3
