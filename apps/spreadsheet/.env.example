# ---------------------------------------------------------------------------
# Client (public) — bundled into the browser. Only non-secret values here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SYNCFUSION_LICENSE=your_syncfusion_license_key_here

# ---------------------------------------------------------------------------
# Server-only — never exposed to the browser. Read by the agent route handlers.
# ---------------------------------------------------------------------------
# Primary agent model provider
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Fallback provider (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Web search (single agent tool). Provider is Tavily by default, Exa as fallback.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here

# Sandbox for the bash/python tools. A jailed scratch dir is created per session
# under this root. Keep it inside the app dir or an ephemeral disk.
AGENT_SANDBOX_ROOT=./.agent-sandbox
# Absolute path to a python3 interpreter for the `python` tool (optional).
AGENT_PYTHON_BIN=python3
